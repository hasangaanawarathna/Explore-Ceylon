# Supabase project settings > API. The publishable key is safe for browser use;
# database access is still enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://ttdlyhasckupbzngcrez.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=add-your-publishable-key-locally

# Optional development fallback used only when Supabase variables are absent.
DATA_DIRECTORY=./data

# DEVELOPMENT/TESTING ONLY. Do not use a shared password in production.
ADMIN_PASSWORD=admin1234
# Generate a long random value, for example: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Existing active Supabase admin account used behind the shared testing login.
ADMIN_SUPABASE_EMAIL=admin-account@example.com

# Server-side Resend settings. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_server_side_api_key
ADMIN_LOGIN_FROM_EMAIL=Explore Ceylon <admin@your-verified-domain.example>
ADMIN_LOGIN_NOTIFY_EMAIL=hasanngaanawarathna@gmail.com
